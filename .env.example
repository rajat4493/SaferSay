# Runtime mode. Use "local" during development, "production" on Vercel.
SAFERSAY_RUNTIME_MODE=local
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Supabase EU Postgres. Use pooler URL for serverless production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL=
DEFAULT_TENANT_ID=

# Auth. Admin/viewer login runs on Supabase Auth (see NEXT_PUBLIC_SUPABASE_*
# above). Enable and configure the Google and Microsoft (Azure) OAuth
# providers in the Supabase dashboard under Authentication > Providers —
# client IDs/secrets for those providers live there, not in this file.
# Only set this to "true" after you have enabled BOTH providers there and
# manually test-signed-in with each one — this is a human confirmation,
# not something the app can verify on its own.
SUPABASE_OAUTH_PROVIDERS_CONFIRMED=

# Comma-separated allowlist of emails granted the platform Super Admin
# tenant switch (tenant/ops management across all tenants — never exempts
# protected reports from the k>=5 threshold). Leave empty to disable.
SUPER_ADMIN_EMAILS=

# Token signing. Must be a long random value in production.
TOKEN_SECRET=replace-with-a-long-random-secret
HEALTHCHECK_SECRET=

# Authenticates the scheduled data-retention purge (see vercel.json's cron
# entry and /api/internal/retention-purge). Vercel Cron automatically sends
# Authorization: Bearer $CRON_SECRET, so setting CRON_SECRET alone is enough
# there; RETENTION_PURGE_SECRET is a separate override if you trigger the
# route from somewhere other than Vercel Cron. Required in production --
# the route refuses to run without either one set.
RETENTION_PURGE_SECRET=

# Stripe placeholders.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_CURRENCY=usd
STRIPE_PRICE_CREDIT_1=
STRIPE_PRICE_CREDIT_3=
STRIPE_PRICE_CREDIT_6=
STRIPE_PRICE_RETENTION_REPORT=
STRIPE_PRICE_RETENTION_COMPLIANCE=

# Resend placeholders.
RESEND_API_KEY=
# Test mode can use: SaferSay <onboarding@resend.dev>
# Verified-domain production should use: SaferSay <survey@safersay.com>
RESEND_FROM_EMAIL="SaferSay <onboarding@resend.dev>"

# AI insights. Prompts are built only from aggregate, k-enforced reports.
# AI_PROVIDER options:
# - anthropic: uses ANTHROPIC_API_KEY and Anthropic Messages API
# - openai: uses OPENAI_API_KEY and OpenAI Chat Completions API
# - openai-compatible: uses AI_API_KEY + AI_API_BASE_URL for compatible providers/gateways
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_API_KEY=
AI_API_BASE_URL=

# Legal/compliance.
LEGAL_ENTITY_NAME=MindscopeAI LLP
PRIVACY_CONTACT_EMAIL=
DATA_RESIDENCY_REGION=EU
DEFAULT_DATA_RETENTION_MONTHS=24
